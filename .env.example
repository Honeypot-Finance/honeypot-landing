# Database Connection
# PostgreSQL connection string for accessing the subgraph metadata database
# Format: postgres://username:password@host:port/database?sslmode=require
# This database contains aggregated user counts across all chains
DB=postgres://username:password@host:port/database?sslmode=require

# Optional: Enable debug notices for database connections (SQL parameters are never logged)
DEBUG=false

# Node Environment
NODE_ENV=development

# WalletConnect Project ID
# Get your project ID from https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Server-only SNAG credential for the legacy loyalty leaderboard.
# Rotate the formerly committed key before setting this in your deployment.
SNAG_API_KEY=
